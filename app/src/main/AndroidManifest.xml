<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Apenas estas duas permissões: dados públicos do TSE e o lembrete opcional do dia da eleição. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        Os votos salvos revelam opinião política (dado sensível, LGPD art. 11): nada sai do
        aparelho. allowBackup=false desliga o backup na nuvem; as regras XML excluem tudo também
        da transferência entre aparelhos (Android 12+) e do backup completo (Android 11 ou menos).
    -->
    <application
        android:name=".ColaEleitoralApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ColaEleitoral"
        tools:targetApi="33">

        <!-- Único componente exportado. Edge-to-edge: o Compose trata os insets, inclusive do teclado. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ColaEleitoral.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Compartilhamento da imagem da cola: só o diretório cacheDir/shared/ (xml/file_paths),
            sem exportar o provider; o app concede leitura por URI a quem recebe o compartilhamento.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
            WorkManager é configurado pela ColaEleitoralApplication (Configuration.Provider com o
            HiltWorkerFactory), então o inicializador padrão sai. O InitializationProvider continua
            para os outros inicializadores do App Startup (ProfileInstaller, lifecycle-process).
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
