<?xml version="1.0" encoding="utf-8"?>
<!--
    Frente do ícone adaptativo: um cartão de papel (o "santinho" ou a cola) com três caixas de
    dígitos vazias, como na tela da urna, duas linhas de texto e um selo com visto. Nenhum número,
    nome, bandeira, brasão ou marca do TSE. Tudo fica dentro da zona segura de 66 dp (círculo de
    raio 33 no centro): o canto mais distante do cartão está a 32,2 dp do centro.
    Também é o ícone do splash (themes.xml), sobre brand_neutral.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Sombra curta do cartão. -->
    <path
        android:fillColor="@color/ic_launcher_shadow"
        android:pathData="M40,30.5h28a5,5 0,0 1,5 5v42a5,5 0,0 1,-5 5h-28a5,5 0,0 1,-5 -5v-42a5,5 0,0 1,5 -5z" />
    <!-- Cartão: 38 x 52 dp, de (35,28) a (73,80). -->
    <path
        android:fillColor="@color/ic_launcher_paper"
        android:pathData="M40,28h28a5,5 0,0 1,5 5v42a5,5 0,0 1,-5 5h-28a5,5 0,0 1,-5 -5v-42a5,5 0,0 1,5 -5z" />
    <!-- Três caixas de dígitos, vazias. -->
    <path
        android:fillColor="@color/ic_launcher_field"
        android:pathData="M41.5,35h5a1.5,1.5 0,0 1,1.5 1.5v8a1.5,1.5 0,0 1,-1.5 1.5h-5a1.5,1.5 0,0 1,-1.5 -1.5v-8a1.5,1.5 0,0 1,1.5 -1.5z M51.5,35h5a1.5,1.5 0,0 1,1.5 1.5v8a1.5,1.5 0,0 1,-1.5 1.5h-5a1.5,1.5 0,0 1,-1.5 -1.5v-8a1.5,1.5 0,0 1,1.5 -1.5z M61.5,35h5a1.5,1.5 0,0 1,1.5 1.5v8a1.5,1.5 0,0 1,-1.5 1.5h-5a1.5,1.5 0,0 1,-1.5 -1.5v-8a1.5,1.5 0,0 1,1.5 -1.5z" />
    <!-- Duas linhas de texto. -->
    <path
        android:fillColor="@color/ic_launcher_field"
        android:pathData="M41.5,51h25a1.5,1.5 0,0 1,0 3h-25a1.5,1.5 0,0 1,0 -3z M41.5,57h13a1.5,1.5 0,0 1,0 3h-13a1.5,1.5 0,0 1,0 -3z" />
    <!-- Selo com visto: círculo de raio 8 em (62,69). -->
    <path
        android:fillColor="@color/ic_launcher_ink"
        android:pathData="M54,69a8,8 0,1 1,16 0a8,8 0,1 1,-16 0z" />
    <path
        android:pathData="M58.3,69.3l2.6,2.6l4.9,-4.9"
        android:strokeWidth="2.4"
        android:strokeColor="@color/ic_launcher_on_ink"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
