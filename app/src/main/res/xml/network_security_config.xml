<?xml version="1.0" encoding="utf-8"?>
<!-- Só HTTPS, confiando apenas nas CAs do sistema (CAs instaladas pelo usuário são ignoradas). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
